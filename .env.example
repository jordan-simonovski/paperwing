# Optional. Raises GitHub search rate limits for the Projects feed.
GITHUB_TOKEN=

# Bluesky feed generator (api/atproto.ts). The host the feeds are served from; must match what the
# publish script is given. Without it, the request's own host is used (fine for one domain).
FEEDGEN_HOSTNAME=your-app.vercel.app
# Your account: the feeds are published under it, and the generator only serves feeds it owns.
# The app password is optional for serving (search works without it today) but required to publish.
BSKY_HANDLE=you.bsky.social
BSKY_APP_PASSWORD=
# Set to 1 to switch Bluesky off in the app without removing anything.
BSKY_DISABLED=

# Optional. Sync between devices. Adding Upstash Redis from the Vercel Marketplace sets the KV_
# pair; a database made on upstash.com gives the UPSTASH_ pair instead. Either works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Local development only: keeps sync data in the dev server's memory instead.
# SYNC_MEMORY=1

# Optional. "Your edition is ready" notifications (needs the sync database too).
# Make keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Vercel sends this to the daily cron in vercel.json; without it, nothing can trigger sends.
CRON_SECRET=

# Optional. Discussion summaries with Claude. Without it, readers can still add their own key in
# Settings (kept in their browser, sent per request). SUMMARY_MODEL defaults to claude-opus-5-5;
# SUMMARY_DAILY_LIMIT caps summaries per visitor per day on this key (needs the sync database).
ANTHROPIC_API_KEY=
SUMMARY_MODEL=
SUMMARY_DAILY_LIMIT=40

# Kept off PaperWing's front page, boards and Bluesky feeds (spam, abuse): DIDs or post at:// URIs,
# separated by commas or spaces. Redeploy (or wait for the minute-long cache) after changing it.
PAPERWING_BLOCKED=
