#!/bin/sh
# Commits carry no AI attribution (AGENTS.md): no AI co-author trailers, no "Generated with" lines.
# Human co-authors are welcome.
if grep -iE '^co-authored-by:.*(claude|anthropic|openai|chatgpt|copilot|codex|gemini|cursor)|generated with \[?(claude|codex|copilot|cursor)' "$1" >/dev/null; then
  echo "commit-msg: remove the AI attribution line from the message (AGENTS.md)." >&2
  exit 1
fi
