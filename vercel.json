{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/oauth-client-metadata.json",
      "destination": "/api/atproto?route=client-metadata"
    },
    {
      "source": "/.well-known/atproto-did",
      "destination": "/api/atproto?route=atproto-did"
    },
    {
      "source": "/.well-known/did.json",
      "destination": "/api/atproto?route=did"
    },
    {
      "source": "/xrpc/:nsid",
      "destination": "/api/atproto?route=:nsid"
    },
    {
      "source": "/t/:channel/:item",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|crawler|spider|facebookexternalhit|Facebot|WhatsApp|Bluesky|Cardyb|Mastodon|Pleroma|Akkoma|Misskey|Iframely|Embedly|Applebot|SkypeUriPreview|Snapchat|Pinterest|vkShare|Viber).*"
        }
      ],
      "destination": "/api/preview?path=/t/:channel/:item"
    },
    {
      "source": "/today/:item",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|crawler|spider|facebookexternalhit|Facebot|WhatsApp|Bluesky|Cardyb|Mastodon|Pleroma|Akkoma|Misskey|Iframely|Embedly|Applebot|SkypeUriPreview|Snapchat|Pinterest|vkShare|Viber).*"
        }
      ],
      "destination": "/api/preview?path=/today/:item"
    },
    {
      "source": "/u/:actor",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|crawler|spider|facebookexternalhit|Facebot|WhatsApp|Bluesky|Cardyb|Mastodon|Pleroma|Akkoma|Misskey|Iframely|Embedly|Applebot|SkypeUriPreview|Snapchat|Pinterest|vkShare|Viber).*"
        }
      ],
      "destination": "/api/preview?path=/u/:actor"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-rEq9QWCpcOKhdywLJ+oR3pW2Cnca6/IixhsVnyJ+B20='; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; media-src 'self' https: blob:; connect-src 'self' https:; font-src 'self' data:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/push.ts": {
      "maxDuration": 60
    }
  }
}
